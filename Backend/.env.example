PORT=4020
# Shared file: relative to Backend, or an absolute path. Blank disables inheritance.
SHARED_ENV_FILE=../../NONGSON/Backend/.env
# Blank inherits the shared server; invalid sample URI is ignored.
MONGO_URI=
MONGO_DB_NAME=thangphu
REDIS_KEY_PREFIX=thangphu
JWT_SECRET=change-me

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

ZALO_APP_ID=
ZALO_APP_SECRET=
ZALO_OA_TOKEN=
ZALO_REFRESH_TOKEN=
# Khoá bí mật OA (oa.zalo.me → Cài đặt → Bảo mật) — xác thực chữ ký webhook
# (X-ZEvent-Signature). Không bắt buộc: để trống thì webhook vẫn nhận và trả
# 200 OK bình thường, chỉ bỏ qua bước xác thực chữ ký.
ZALO_OA_SECRET_KEY=

CORS_ORIGIN=*
PUBLIC_URL=http://localhost:4020
# Mã xác minh domain API riêng của Thăng Phú.
ZALO_SITE_VERIFICATION=

# ===== Lịch cắt điện (EVN CPC) =====
# TODO: chưa xác định mã đơn vị điện lực phụ trách khu vực Thăng Phú (xem
# docs/SETUP_CHECKLIST.md) — để trống thì đồng bộ tự bỏ qua.
EVNCPC_ORG_CODE=
EVNCPC_SUBORG_CODE=
# URL mẫu (Thăng Điền): https://xenvn.com/lich-cup-dien/dien-luc-thang-binh-pc05ff/
XENVN_URL=
LICH_CUP_DIEN_INGEST_SECRET=

# ===== Văn bản - Chính sách =====
# Danh sách văn bản CMS14 đã kiểm tra trên cổng thông tin của xã.
VAN_BAN_SOURCE_URL=https://thangphu.danang.gov.vn/van-ban

# ===== Tin tức (trang TTĐT xã) =====
# Trang chủ tổng hợp các chuyên mục CMS14 của Thăng Phú.
NEWS_SOURCE_URL=https://thangphu.danang.gov.vn/

# ===== Cổng góp ý 1022 (gopy.danang.gov.vn) =====
# TODO: quyết định dùng tài khoản 1022 riêng cho Thăng Phú hay dùng chung với xã
# khác (xem docs/SETUP_CHECKLIST.md).
# Để trống baseUrl/username/password thì tính năng tự tắt (không đẩy gì lên 1022).
CGY1022_BASE_URL=
CGY1022_USERNAME=
CGY1022_PASSWORD=
CGY1022_GOPY_PATH=
CGY1022_USER_ID=0
CGY1022_DEFAULT_EMAIL=
CGY1022_NGUON=
# Chạy: node scripts/cgy1022-map-categories.js để lấy gợi ý map dưới đây
CGY1022_LINHVUC_MAP={}
CGY1022_LINHVUC_DEFAULT=

# ===== IOCTC - Tra cứu hồ sơ TTHC (tctthc.1022.vn) =====
# TODO: quyết định dùng tài khoản IOCTC riêng hay dùng chung với xã khác.
# Để trống username/password thì chức năng tra cứu tự tắt (503).
IOCTC_BASE_URL=
IOCTC_USERNAME=
IOCTC_PASSWORD=

# ===== Tự động đăng tin cào lên Zalo OA (tạo bài viết) =====
# Dùng chung token OA (ZALO_OA_TOKEN/ZALO_REFRESH_TOKEN ở trên). Bật sau khi đã
# chạy: node scripts/backfill-news-zalo-skip.js (để không dồn tin cũ lên OA).
ZALO_ARTICLE_ENABLED=false
# Ảnh cover mặc định khi tin không có ảnh (Zalo bắt buộc bài viết có cover)
ZALO_ARTICLE_DEFAULT_COVER=
# Bật thêm để tự động GỬI (broadcast) bài vừa tạo tới TOÀN BỘ follower OA —
# cần quyền Official Account API đã duyệt + cân nhắc kỹ vì không thể thu hồi
# sau khi gửi. Yêu cầu ZALO_ARTICLE_ENABLED=true để có bài mà gửi.
ZALO_BROADCAST_ENABLED=false

# ===== Trợ lý số (Claude API) =====
# Để trống thì chức năng tự tắt (503). Lấy key tại console.anthropic.com
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# ===== Kỹ năng PCTT — thư mục chứa video (ngoài git) =====
# Để trống thì dùng mặc định Backend/media
MEDIA_DIR=
