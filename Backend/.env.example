# MINIAPP_THANGPHU - điền thông tin riêng, không dùng credentials của xã khác.
# Danh sách và cách lấy thông tin: docs/SETUP_CHECKLIST.md
NODE_ENV=development
PORT=4012
# Database riêng. Có thể dùng mongodb://127.0.0.1:27017/thangphu khi đã cài MongoDB.
MONGO_URI=
# Tự sinh chuỗi ngẫu nhiên ít nhất 32 ký tự.
JWT_SECRET=
PUBLIC_URL=http://localhost:4012
CORS_ORIGIN=http://localhost:5182,http://localhost:5183,http://localhost:3012,http://localhost:3013
ADMIN_SEED_USERNAME=admin
ADMIN_SEED_PASSWORD=

# Upload: để trống Cloudinary thì dùng Backend/public/images của dự án này.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Zalo Developers / OA của Thăng Phú (khác Mini App APP_ID).
ZALO_APP_ID=
ZALO_APP_SECRET=
ZALO_OA_TOKEN=
ZALO_REFRESH_TOKEN=
ZALO_OA_SECRET_KEY=
ZALO_SITE_VERIFICATION=

# Thông tin liên hệ hiển thị tại trang điều khoản.
CONTACT_ADDRESS=
CONTACT_PHONE=
CONTACT_EMAIL=
CONTACT_WEBSITE=

# Lịch điện: xác nhận đơn vị phụ trách và URL nguồn trước khi bật.
EVNCPC_API_URL=https://cskh-api.cpc.vn/api/remote/outages/area
EVNCPC_ORG_LIST_URL=https://cskh-api.cpc.vn/api/remote/organizations
EVNCPC_ORG_CODE=
EVNCPC_SUBORG_CODE=
XENVN_URL=
LICH_CUP_DIEN_INGEST_SECRET=

# Xác nhận URL và kiểm tra parser HTML của nguồn mới.
VAN_BAN_SOURCE_URL=
NEWS_SOURCE_URL=

CGY1022_BASE_URL=
CGY1022_USERNAME=
CGY1022_PASSWORD=
CGY1022_GOPY_PATH=/api/gopy
CGY1022_USER_ID=0
CGY1022_DEFAULT_EMAIL=
CGY1022_NGUON=
CGY1022_LINHVUC_MAP={}
CGY1022_LINHVUC_DEFAULT=

IOCTC_BASE_URL=
IOCTC_USERNAME=
IOCTC_PASSWORD=

ZALO_ARTICLE_ENABLED=false
ZALO_ARTICLE_DEFAULT_COVER=
ZALO_BROADCAST_ENABLED=false
ANTHROPIC_API_KEY=
# Điền model được cấp quyền trong tài khoản của bạn.
ANTHROPIC_MODEL=
# Để trống: Backend/media (riêng trong dự án này).
MEDIA_DIR=
